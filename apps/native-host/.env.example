MUNSHI_RUNTIME_ROOT=
MUNSHI_DATABASE_PATH=
MUNSHI_N8N_WEBHOOK_URL=
MUNSHI_N8N_WEBHOOK_SECRET=
MUNSHI_OUTBOX_POLL_SECONDS=5
MUNSHI_LOG_LEVEL=INFO
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Complete Application Loop execution gates. Keep off unless explicitly enabled.
MUNSHI_APPLY_LIVE_HANDOFF_ENABLED=false
MUNSHI_APPLY_PLAN_SUPERSESSION_ENABLED=false
MUNSHI_APPLY_BACKGROUND_PREPARE_ENABLED=false
MUNSHI_APPLY_HOSTED_PREPARE_WORKER_ENABLED=false
MUNSHI_FINAL_REVIEW_ENABLED=false
MUNSHI_FINAL_SUBMIT_ENABLED=false

# Single-approval AutoApply: canonical Hunter-issued submit authority (default-off).
# The hosted submit worker consumes the already-approved Hunter authority; it never
# creates a second customer approval. Real employer submission requires ALL three
# switches below plus a successfully claimed one-use authority. Keep them false
# outside an explicitly authorised production mission.
MUNSHI_APPLY_PRODUCTION_SUBMIT_AUTHORITY_ENABLED=false
MUNSHI_APPLY_HOSTED_SUBMIT_WORKER_ENABLED=false
MUNSHI_APPLY_SUBMIT_POLL_SECONDS=1
