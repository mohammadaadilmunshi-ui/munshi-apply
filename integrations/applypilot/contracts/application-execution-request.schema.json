{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munshi.systems/schemas/applypilot/application-execution-request.schema.json",
  "title": "MUNSHI Autonomous Application Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_digest",
    "job",
    "artifacts",
    "answers",
    "permissions",
    "execution_context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "minLength": 16
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "url"],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": ["string", "null"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "canonical_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "title": {
          "type": ["string", "null"]
        },
        "company": {
          "type": ["string", "null"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resume"],
      "properties": {
        "resume": {
          "$ref": "#/$defs/artifact"
        },
        "cover_letter": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id",
          "question_key",
          "value",
          "approved",
          "provenance"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "minLength": 1
          },
          "question_key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "approved": {
            "const": true
          },
          "sensitive": {
            "type": "boolean",
            "default": false
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigate",
        "fill",
        "upload_documents",
        "final_submit",
        "security_checkpoint_bypass"
      ],
      "properties": {
        "navigate": {
          "type": "boolean"
        },
        "fill": {
          "type": "boolean"
        },
        "upload_documents": {
          "type": "boolean"
        },
        "final_submit": {
          "type": "boolean"
        },
        "security_checkpoint_bypass": {
          "const": false
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_ai_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_agent_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "environment"],
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "environment": {
          "enum": ["local-test", "ci", "staging", "production"]
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "path"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
