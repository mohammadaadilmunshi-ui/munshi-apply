{
  "name": "munshi-apply",
  "version": "0.1.0",
  "private": true,
  "description": "Universal, evidence-grounded job application assistant for Microsoft Edge.",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/extension",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run dev --workspace @munshi-apply/extension",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "node scripts/verify-artifacts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
